@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0b0e14;
  --panel: #151a25;
  --panel-soft: #1d2533;
  --border: #263245;
  --text: #edf2f7;
  --muted: #9aa7b5;
  --green: #00d084;
  --green-soft: rgba(0, 208, 132, 0.12);
  --red: #ff4d4d;
  --amber: #f7c948;
  --blue: #60a5fa;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: 'Inter', sans-serif;
}

button {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  background: radial-gradient(circle at top, rgba(0,208,132,0.12), transparent 35%), var(--bg);
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1rem 2rem;
  border-bottom: 1px solid var(--border);
  background: rgba(11, 14, 20, 0.82);
  backdrop-filter: blur(12px);
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.brand-icon {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, rgba(0,208,132,0.15), rgba(96,165,250,0.18));
  border: 1px solid rgba(96,165,250,0.2);
  font-size: 1.25rem;
}

.brand-line {
  font-weight: 800;
  letter-spacing: 0.08em;
}

.brand-sub {
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.04em;
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.filter {
  border: 1px solid var(--border);
  background: transparent;
  color: var(--muted);
  border-radius: 999px;
  padding: 0.6rem 1rem;
  cursor: pointer;
  transition: 0.2s ease;
}

.filter.active {
  background: #edf2f7;
  color: #0b0e14;
  border-color: transparent;
  font-weight: 700;
}

.content {
  max-width: 1200px;
  margin: 0 auto;
  padding: 1.5rem 1rem 2rem;
}

.summary-panel {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.summary-panel > div {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 1rem 1.2rem;
}

.eyebrow {
  color: var(--muted);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.7rem;
  margin-bottom: 0.4rem;
}

.summary-panel h2 {
  margin: 0;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
}

.error-banner {
  background: rgba(255, 77, 77, 0.1);
  border: 1px solid rgba(255, 77, 77, 0.4);
  color: #ffb4b4;
  border-radius: 12px;
  padding: 0.9rem 1rem;
  margin-bottom: 1rem;
}

.loading-box,
.empty-box {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 2rem;
  text-align: center;
  color: var(--muted);
}

.match-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 1rem;
}

.match-card {
  background: linear-gradient(180deg, rgba(21,26,37,0.94), rgba(17,21,31,1));
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 1rem;
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.25);
}

.match-topline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 0.75rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid rgba(255,255,255,0.06);
}

.league-name {
  color: var(--muted);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.status {
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  padding: 0.35rem 0.6rem;
  border-radius: 999px;
  border: 1px solid transparent;
  text-transform: uppercase;
}

.status.in { background: var(--green-soft); color: var(--green); border-color: rgba(0,208,132,0.35); }
.status.post { background: rgba(247,201,73,0.1); color: var(--amber); border-color: rgba(247,201,73,0.3); }
.status.preview { background: rgba(96,165,250,0.1); color: var(--blue); border-color: rgba(96,165,250,0.3); }

.match-body {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0.5rem;
  align-items: center;
  padding: 1rem 0 0.75rem;
}

.team {
  display: flex;
  align-items: center;
  gap: 0.8rem;
}

.side-right {
  justify-content: flex-end;
  text-align: right;
}

.flag {
  font-size: 1.5rem;
  display: inline-flex;
  width: 38px;
  height: 38px;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.08);
}

.team-name {
  font-weight: 700;
}

.team-meta {
  color: var(--muted);
  font-size: 0.76rem;
}

.score-box {
  min-width: 90px;
  text-align: center;
  font-size: 1.1rem;
  font-weight: 800;
  padding: 0.6rem 0.7rem;
  background: rgba(255,255,255,0.03);
  border-radius: 12px;
  border: 1px solid rgba(255,255,255,0.06);
}

.match-footer {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 0.75rem;
  align-items: end;
  padding-top: 0.25rem;
}

.market-box {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.05);
  border-radius: 12px;
  padding: 0.7rem 0.75rem;
}

.market-box.highlight {
  background: rgba(0,208,132,0.07);
  border-color: rgba(0,208,132,0.25);
}

.label {
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

.cta {
  border: 0;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--green), #86efac);
  color: #04170e;
  font-weight: 800;
  padding: 0.8rem 1rem;
  cursor: pointer;
}

.modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.65);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1.5rem;
  z-index: 30;
}

.modal {
  width: min(760px, 100%);
  max-height: 85vh;
  overflow: auto;
  border-radius: 18px;
  background: #101722;
  border: 1px solid var(--border);
  padding: 1.2rem;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 1rem;
}

.modal-header h3 {
  margin: 0;
  font-size: clamp(1.3rem, 2vw, 2rem);
}

.close-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid var(--border);
  color: var(--text);
  background: transparent;
  cursor: pointer;
  font-size: 1.4rem;
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.75rem;
  margin-top: 1rem;
}

.detail-box,
.reason-box {
  background: rgba(255,255,255,0.02);
  border: 1px solid rgba(255,255,255,0.06);
  border-radius: 12px;
  padding: 0.85rem 0.9rem;
}

.reason-box {
  margin-top: 1rem;
}

.reason-box h4 {
  margin: 0 0 0.5rem;
}

.reason-box p {
  margin: 0;
  color: var(--muted);
  line-height: 1.6;
}

.analysis-list {
  margin: 1rem 0 0;
  padding-left: 1.1rem;
  display: grid;
  gap: 0.7rem;
  color: var(--muted);
  line-height: 1.5;
}

@media (max-width: 720px) {
  .topbar {
    flex-direction: column;
    align-items: flex-start;
    padding: 1rem;
  }

  .summary-panel {
    grid-template-columns: 1fr;
  }

  .match-footer {
    grid-template-columns: 1fr;
  }

  .match-body {
    grid-template-columns: 1fr;
    text-align: center;
  }

  .team,
  .side-right {
    justify-content: center;
    text-align: center;
  }

  .detail-grid {
    grid-template-columns: 1fr;
  }
}
